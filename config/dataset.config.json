    "entityName": "articles",
    "singularName": "Artigo",
    "pluralName": "Artigos",
    "primaryKey": "id",
    "secondaryKey": "doi"
  },
  "schema": {
    "searchFields": ["title", "abstract", "authors", "keywords", "section", "issue"],
    "facets": [
      { "key": "year", "label": "Ano / Edição", "type": "number", "multi": true },
      { "key": "author", "label": "Autor / Pesquisador", "type": "string", "targetField": "authors" },
      { "key": "section", "label": "Eixo Temático / Seção", "type": "string", "targetField": "section" },
      { "key": "keyword", "label": "Palavra-chave / Tópico", "type": "string", "targetField": "keywords" }
    ],
    "sortFields": [
      { "key": "year", "label": "Ano / Edição" },
      { "key": "title", "label": "Título" },
      { "key": "doi", "label": "DOI" }
    ]
  },
  "stats": {
    "topLists": [
      { "key": "topAuthors", "label": "Principais Autores / Pesquisadores", "sourceField": "authors", "limit": 10 },
      { "key": "topKeywords", "label": "Palavras-chave & Tópicos", "sourceField": "keywords", "limit": 10 },
      { "key": "topSections", "label": "Eixos Temáticos / Seções", "sourceField": "section", "limit": 10 }
    ],
    "breakdowns": [
      { "key": "yearDistribution", "label": "Distribuição por Ano / Edição", "sourceField": "year" },
      { "key": "sectionBreakdown", "label": "Distribuição por Eixo Temático", "sourceField": "section" }
    ]
  }
}
