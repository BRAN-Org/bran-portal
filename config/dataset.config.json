  },
  "dataset": {
    "title": "BRAN Open Data Portal",
    "subtitle": "Portal Unificado de Dados Abertos e API da Ciência da Informação",
    "description": "Infraestrutura de dados acadêmicos e cientométricos abertos no Brasil. Acesso unificado aos anais e publicações do ENANCIB, CBBD, EBBC, DataGramaZero e ABEC Meeting em formatos abertos (JSON, CSV, SQLite) e API REST pública.",
    "version": "2.0.0",
    "doi": "",
