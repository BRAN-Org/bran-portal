---
interface Props {
  searchIndex: Array<{
    name: string;
    sigla: string;
    type: string;
    status: string;
    status_label: string;
    records: number | null;
    coverage: string;
    health: string;
    app_url: string | null;
    repo_url: string | null;
    zenodo_url: string | null;
    slug: string;
    notes: string;
    suggest_url?: string;
  }>;
}

const { searchIndex } = Astro.props;
---

<div class="w-full bg-white rounded-xl shadow-xs border border-slate-200/90 overflow-hidden" id="checker-root">
  <div class="p-6 sm:p-8 bg-gradient-to-b from-blue-50/50 to-white border-b border-slate-100">
    <div class="flex items-center gap-2 text-xs uppercase tracking-wider font-bold text-[#004c8c] mb-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      Verificador Universal do Ecossistema
    </div>
    <h2 class="text-2xl sm:text-3xl font-bold font-serif text-slate-900 tracking-tight">
      Existe na BRAN?
    </h2>
    <p class="text-sm text-slate-600 mt-1.5 max-w-2xl">
      Digite a sigla ou nome de uma conferência, simpósio ou periódico científico brasileiro para verificar se seus anais ou fascículos já estão indexados, auditados ou no backlog da organização.
    </p>

    <!-- Search input -->
    <div class="mt-6 relative">
      <div class="relative flex items-center">
        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>
        <input 
          type="text" 
          id="checker-input"
          placeholder="Ex: EBBC, ENANCIB, CBBD, SNBU, DataGramaZero, SBRC..." 
          class="w-full pl-11 pr-24 py-3.5 text-base text-slate-900 bg-white border border-slate-300 rounded-lg shadow-inner focus:outline-none focus:ring-2 focus:ring-[#004c8c] focus:border-transparent transition-all"
          autocomplete="off"
        />
        <button 
          id="checker-clear-btn" 
          type="button" 
          class="hidden absolute right-3 px-2 py-1 text-xs text-slate-400 hover:text-slate-600 rounded"
        >
          Limpar ✕
        </button>
      </div>

      <!-- Quick suggestions pills -->
      <div class="flex flex-wrap items-center gap-2 mt-3 text-xs text-slate-500">
        <span class="font-medium text-slate-600">Testar consultas:</span>
        <button type="button" class="quick-pill px-2.5 py-1 bg-slate-100 hover:bg-blue-100 hover:text-[#004c8c] rounded-md font-mono transition-colors" data-query="ENANCIB">ENANCIB</button>
        <button type="button" class="quick-pill px-2.5 py-1 bg-slate-100 hover:bg-blue-100 hover:text-[#004c8c] rounded-md font-mono transition-colors" data-query="EBBC">EBBC</button>
        <button type="button" class="quick-pill px-2.5 py-1 bg-slate-100 hover:bg-blue-100 hover:text-[#004c8c] rounded-md font-mono transition-colors" data-query="CBBD">CBBD</button>
        <button type="button" class="quick-pill px-2.5 py-1 bg-slate-100 hover:bg-blue-100 hover:text-[#004c8c] rounded-md font-mono transition-colors" data-query="DataGramaZero">DataGramaZero</button>
        <button type="button" class="quick-pill px-2.5 py-1 bg-slate-100 hover:bg-blue-100 hover:text-[#004c8c] rounded-md font-mono transition-colors" data-query="SNBU">SNBU</button>
        <button type="button" class="quick-pill px-2.5 py-1 bg-slate-100 hover:bg-blue-100 hover:text-[#004c8c] rounded-md font-mono transition-colors" data-query="SBRC">SBRC</button>
      </div>
    </div>
  </div>

  <!-- Live Results Container -->
  <div id="checker-results" class="p-6 sm:p-8 space-y-4">
    <!-- Estado Inicial Padrão -->
    <div id="checker-initial-state" class="text-center py-6 text-slate-500">
      <div class="inline-flex p-3 rounded-full bg-slate-100 text-slate-400 mb-2">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16l2.879-2.879m0 0a3 3 0 104.243-4.242 3 3 0 00-4.243 4.242zM21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      </div>
      <p class="text-sm font-medium">Digite um termo acima ou clique em uma das consultas sugeridas para testar o verificador em tempo real.</p>
    </div>

    <!-- Lista Dinâmica de Matches (Injetado via JS) -->
    <div id="checker-matches-container" class="space-y-3 hidden"></div>

    <!-- Feedback 'Não Encontrado' com Ação de Submissão -->
    <div id="checker-not-found" class="hidden p-6 rounded-lg border border-amber-200 bg-amber-50/70 text-amber-900">
      <div class="flex items-start gap-3">
        <div class="p-2 bg-amber-100 text-amber-800 rounded-lg shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        </div>
        <div class="space-y-2 flex-1">
          <h4 class="font-bold text-base text-amber-950 font-serif">Esta fonte ainda não está indexada na BRAN Org</h4>
          <p class="text-sm text-amber-900 leading-relaxed">
            A consulta <strong id="not-found-term" class="underline"></strong> não possui anais nem fascículos mapeados na organização atualmente.
          </p>
          <div class="pt-2 flex flex-wrap items-center gap-3">
            <a 
              id="suggest-issue-btn"
              href="https://github.com/BRAN-Org/portal/issues/new" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold rounded-md bg-[#092340] text-white hover:bg-[#004c8c] transition-colors"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
              Sugerir Inclusão desta Base no GitHub
            </a>
            <a 
              href="/docs/curadoria" 
              class="inline-flex items-center text-xs font-semibold text-amber-900 hover:text-amber-950 underline underline-offset-4"
            >
              Ver critérios de curadoria & schemas →
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Dados brutos embutidos para busca local instantânea (zero requisições de rede) -->
<script define:vars={{ searchIndex }}>
  window.__BRAN_SEARCH_INDEX__ = searchIndex;

  function initChecker() {
    const input = document.getElementById('checker-input');
    const clearBtn = document.getElementById('checker-clear-btn');
    const initialState = document.getElementById('checker-initial-state');
    const matchesContainer = document.getElementById('checker-matches-container');
    const notFoundBox = document.getElementById('checker-not-found');
    const notFoundTerm = document.getElementById('not-found-term');
    const suggestBtn = document.getElementById('suggest-issue-btn');
    const quickPills = document.querySelectorAll('.quick-pill');

    if (!input || !matchesContainer) return;

    function normalize(str) {
      return (str || '')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .trim();
    }

    function renderResults(query) {
      const q = normalize(query);

      if (!q) {
        clearBtn.classList.add('hidden');
        initialState.classList.remove('hidden');
        matchesContainer.classList.add('hidden');
        notFoundBox.classList.add('hidden');
        return;
      }

      clearBtn.classList.remove('hidden');
      initialState.classList.add('hidden');

      const matches = window.__BRAN_SEARCH_INDEX__.filter(item => {
        const nameNorm = normalize(item.name);
        const siglaNorm = normalize(item.sigla);
        return siglaNorm.includes(q) || nameNorm.includes(q);
      });

      if (matches.length > 0) {
        notFoundBox.classList.add('hidden');
        matchesContainer.classList.remove('hidden');

        matchesContainer.innerHTML = matches.map(item => {
          const isIndexed = item.status === 'INDEXED';
          const badgeClass = isIndexed 
            ? 'bg-emerald-50 text-emerald-800 border-emerald-300' 
            : 'bg-blue-50 text-blue-800 border-blue-300';

          return `
            <div class="p-4 sm:p-5 rounded-lg border border-slate-200 bg-white hover:border-slate-300 transition-all shadow-2xs">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <div class="flex items-center gap-3">
                  <span class="px-2.5 py-1 text-xs font-bold rounded-md border ${badgeClass}">
                    ${isIndexed ? '✓ INDEXADO NA BRAN' : '⏳ NO BACKLOG / EM AVALIAÇÃO'}
                  </span>
                  <span class="text-xs text-slate-500 font-mono">${item.type}</span>
                </div>
                ${item.records ? `
                  <div class="text-xs font-semibold text-slate-700">
                    <span class="text-base font-bold text-slate-900 font-serif">${item.records.toLocaleString('pt-BR')}</span> trabalhos catalogados
                  </div>
                ` : ''}
              </div>

              <div class="mt-2.5">
                <h3 class="text-lg font-bold text-slate-900 font-serif">
                  ${item.sigla} — <span class="font-normal text-slate-700 text-base">${item.name}</span>
                </h3>
                <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                  ${item.notes || ''}
                </p>
                <div class="text-xs text-slate-500 font-mono mt-1">
                  Cobertura Temporal: <strong>${item.coverage}</strong>
                </div>
              </div>

              <div class="mt-4 pt-3 border-t border-slate-100 flex flex-wrap items-center gap-3">
                ${isIndexed ? `
                  <a href="${item.slug}" class="text-xs font-semibold px-3 py-1.5 rounded bg-[#092340] text-white hover:bg-[#004c8c] transition-colors">
                    Ver no Catálogo →
                  </a>
                  ${item.app_url ? `
                    <a href="${item.app_url}" target="_blank" rel="noopener noreferrer" class="text-xs font-semibold px-3 py-1.5 rounded border border-slate-200 text-slate-700 hover:bg-slate-50 transition-colors">
                      API REST / Web App ↗
                    </a>
                  ` : ''}
                  ${item.zenodo_url ? `
                    <a href="${item.zenodo_url}" target="_blank" rel="noopener noreferrer" class="text-xs font-semibold px-3 py-1.5 rounded border border-slate-200 text-slate-700 hover:bg-slate-50 transition-colors">
                      Zenodo DOI ↗
                    </a>
                  ` : ''}
                ` : `
                  <a href="${item.suggest_url || 'https://github.com/BRAN-Org/portal/issues/new'}" target="_blank" rel="noopener noreferrer" class="text-xs font-semibold px-3 py-1.5 rounded bg-blue-700 text-white hover:bg-blue-800 transition-colors">
                    Acompanhar / Sugerir Dados no GitHub ↗
                  </a>
                `}
              </div>
            </div>
          `;
        }).join('');
      } else {
        matchesContainer.classList.add('hidden');
        notFoundBox.classList.remove('hidden');
        notFoundTerm.textContent = `"${query}"`;
        const issueTitle = encodeURIComponent(`Sugestão de Base: ${query.trim()}`);
        suggestBtn.href = `https://github.com/BRAN-Org/portal/issues/new?title=${issueTitle}&body=Por+favor+informe+a+URL+oficial+dos+anais+ou+peri%C3%B3dico+e+se+possui+DOI+ou+OJS.`;
      }
    }

    input.addEventListener('input', (e) => {
      renderResults(e.target.value);
    });

    clearBtn.addEventListener('click', () => {
      input.value = '';
      input.focus();
      renderResults('');
    });

    quickPills.forEach(pill => {
      pill.addEventListener('click', () => {
        const query = pill.getAttribute('data-query');
        input.value = query;
        renderResults(query);
      });
    });
  }

  // Inicializa imediatamente e no carregamento
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initChecker);
  } else {
    initChecker();
  }
</script>
