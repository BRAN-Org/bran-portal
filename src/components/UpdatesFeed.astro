---
interface Props {
  updates: Array<{
    date: string;
    type: string;
    title: string;
    description: string;
    target_id: string;
    badge: string;
    sha256_short: string;
  }>;
}

const { updates } = Astro.props;

function formatDate(isoStr: string) {
  const [year, month, day] = isoStr.split('-');
  return `${day}/${month}/${year}`;
}
---

<div class="bg-white rounded-xl shadow-xs border border-slate-200/90 overflow-hidden h-full flex flex-col">
  <div class="p-6 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between">
    <div>
      <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#004c8c]">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path></svg>
        Registro de Atividades
      </div>
      <h3 class="text-xl font-bold font-serif text-slate-900 mt-1">
        Atualizações & Proveniência
      </h3>
    </div>
    <span class="text-xs font-mono text-slate-500 font-medium">
      Feed Censitário
    </span>
  </div>

  <div class="p-6 divide-y divide-slate-100 flex-1 overflow-y-auto max-h-[460px]">
    {updates.map(item => (
      <div class="py-4 first:pt-0 last:pb-0 space-y-1.5">
        <div class="flex items-center justify-between gap-2">
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold px-2 py-0.5 rounded bg-slate-100 text-slate-700 font-mono">
              {item.badge}
            </span>
            <span class="text-xs text-slate-400 font-mono">{formatDate(item.date)}</span>
          </div>
          <span class="text-[11px] font-mono text-slate-400 bg-slate-50 px-1.5 py-0.5 rounded border border-slate-100" title="Hash SHA-256 do bundle de dados">
            SHA: {item.sha256_short}
          </span>
        </div>

        <h4 class="text-sm font-bold text-slate-900 font-serif leading-snug">
          {item.title}
        </h4>

        <p class="text-xs text-slate-600 leading-relaxed">
          {item.description}
        </p>

        <div class="pt-1 flex items-center gap-3 text-xs">
          <a href={`/databases#${item.target_id}`} class="font-medium text-[#004c8c] hover:underline">
            Ver detalhes da base →
          </a>
        </div>
      </div>
    ))}
  </div>

  <div class="p-4 bg-slate-50 border-t border-slate-100 text-center text-xs text-slate-500">
    Todos os lançamentos são auditados e validados pelo protocolo CRONA antes de cada publicação.
  </div>
</div>
