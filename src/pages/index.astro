            <p>Somos uma iniciativa comunitária sem fins lucrativos — todos os nossos dados são abertos sob licença livre.</p>
            <a href="https://github.com/BRAN-Org" target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-[#C87D32] hover:underline mt-1 inline-block">
              Participe no GitHub →
            </a>
          </div>
        </div>

      </div>

    </div>
  </section>


  <!-- SEÇÃO DE BASES CANÔNICAS AUDITADAS & CALENDÁRIO -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Lista das 5 Bases Canônicas -->
      <div class="lg:col-span-7 space-y-4">
        <div class="pb-3 border-b border-[#A1A1AA]/30 flex items-center justify-between">
          <div>
            <h2 class="text-xl sm:text-2xl font-bold font-serif text-[#18181B]">
              Acervos Canônicos em Produção
            </h2>
            <p class="text-xs text-[#A1A1AA] mt-0.5">
              Bases auditadas e integradas com a engine <code class="font-mono text-[#18181B]">bran-web-database-template</code>
            </p>
          </div>
          <a href="/databases" class="text-xs font-bold text-[#C87D32] hover:underline">
            Ver todas →
          </a>
        </div>

        <div class="space-y-3">
          {databases.map(db => (
            <div class="bg-white rounded-lg border border-[#A1A1AA]/30 p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:border-[#C87D32] transition-all">
              <div class="space-y-1 flex-1">
                <div class="flex items-center gap-2">
                  <span class="px-2 py-0.5 text-xs font-mono font-bold rounded bg-[#18181B] text-white">
                    {db.sigla}
                  </span>
                  <span class="text-xs font-mono text-[#A1A1AA]">
                    {db.coverage_years}
                  </span>
                  <span class="text-xs font-bold px-2 py-0.5 rounded bg-[#C87D32]/10 text-[#C87D32] border border-[#C87D32]/30">
                    ✓ Auditado
                  </span>
                </div>
                <h3 class="font-serif font-bold text-base text-[#18181B]">
                  {db.name}
                </h3>
                <p class="text-xs text-stone-600 line-clamp-1">
                  {db.description}
                </p>
              </div>

              <div class="flex sm:flex-col items-center sm:items-end justify-between shrink-0 gap-2">
                <div class="text-right">
                  <span class="text-base font-bold font-serif text-[#18181B] block leading-none">
                    {db.stats.total_records.toLocaleString('pt-BR')}
                  </span>
                  <span class="text-[10px] uppercase tracking-wider text-[#A1A1AA] font-semibold">
                    trabalhos
                  </span>
                </div>
                <a 
                  href={db.app_url} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="text-xs font-semibold px-3 py-1 rounded bg-[#18181B] text-white hover:bg-[#C87D32] transition-colors"
                >
                  API & Web App ↗
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Calendário de Curadoria -->
      <div class="lg:col-span-5">
        <CalendarWidget calendar={current_calendar} />
      </div>

    </div>
  </section>

  <!-- Script para a Busca Instantânea no Hero e Formulário de Newsletter -->
  <script define:vars={{ searchIndex }}>
    window.__BRAN_SEARCH_INDEX__ = searchIndex;

    function setupHeroInteractivity() {
      const input = document.getElementById('hero-search-input');
      const dropdown = document.getElementById('hero-results-dropdown');
      const form = document.getElementById('newsletter-form');
      const successMsg = document.getElementById('newsletter-success');

      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          successMsg.classList.remove('hidden');
          form.reset();
        });
      }

      if (!input || !dropdown) return;

      function normalize(str) {
        return (str || '')
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .trim();
      }

      function handleSearch() {
        const q = normalize(input.value);

        if (!q) {
          dropdown.classList.add('hidden');
          dropdown.innerHTML = '';
          return;
        }

        const matches = window.__BRAN_SEARCH_INDEX__.filter(item => {
          const nameNorm = normalize(item.name);
          const siglaNorm = normalize(item.sigla);
          return siglaNorm.includes(q) || nameNorm.includes(q);
        });

        dropdown.classList.remove('hidden');

        if (matches.length > 0) {
          dropdown.innerHTML = matches.map(item => {
            const isIndexed = item.status === 'INDEXED';
            return `
              <div class="p-3.5 hover:bg-white transition-colors">
                <div class="flex items-center justify-between gap-2">
                  <div class="flex items-center gap-2">
                    <span class="px-2 py-0.5 text-[10px] font-bold font-mono rounded ${isIndexed ? 'bg-[#C87D32]/10 text-[#C87D32] border border-[#C87D32]/30' : 'bg-[#18181B]/10 text-[#18181B]'}">
                      ${isIndexed ? '✓ INDEXADO' : '⏳ NO BACKLOG'}
                    </span>
                    <span class="text-xs font-bold text-[#18181B] font-serif">${item.sigla}</span>
                    <span class="text-xs text-stone-600 truncate max-w-xs sm:max-w-md">${item.name}</span>
                  </div>
                  ${item.records ? `
                    <span class="text-xs font-mono font-bold text-[#18181B] shrink-0">
                      ${item.records.toLocaleString('pt-BR')} artigos
                    </span>
                  ` : ''}
                </div>
                <div class="mt-2 flex items-center justify-between text-xs">
                  <span class="text-[#A1A1AA] font-mono text-[11px]">${item.type} • ${item.coverage}</span>
                  <div class="flex items-center gap-2">
                    ${isIndexed ? `
                      <a href="${item.slug}" class="font-bold text-[#C87D32] hover:underline">
                        Ver Detalhes →
                      </a>
                    ` : `
                      <a href="${item.suggest_url || 'https://github.com/BRAN-Org/portal/issues/new'}" target="_blank" rel="noopener noreferrer" class="font-bold text-[#C87D32] hover:underline">
                        Sugerir / Acompanhar ↗
                      </a>
                    `}
                  </div>
                </div>
              </div>
            `;
          }).join('');
        } else {
          const issueTitle = encodeURIComponent(`Sugestão de Base: ${input.value.trim()}`);
          dropdown.innerHTML = `
            <div class="p-4 bg-[#F5F5F4] text-[#18181B] border-l-4 border-[#C87D32] space-y-2">
              <div class="font-bold text-xs font-serif text-[#18181B]">
                Esta fonte ainda não está indexada na BRAN Org
              </div>
              <p class="text-xs text-stone-600">
                Não encontramos registros para "${input.value}". Deseja propor a curadoria deste acervo?
              </p>
              <div class="pt-1">
                <a 
                  href="https://github.com/BRAN-Org/portal/issues/new?title=${issueTitle}&body=Por+favor+informe+a+URL+oficial+dos+anais+ou+peri%C3%B3dico+e+se+possui+DOI+ou+OJS." 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-[#C87D32] text-white font-bold text-xs hover:bg-[#b06a28] transition-colors"
                >
                  + Propor Inclusão desta Base no GitHub
                </a>
              </div>
            </div>
          `;
        }
      }

      input.addEventListener('input', handleSearch);

      // Fecha dropdown ao clicar fora
      document.addEventListener('click', (e) => {
        if (!input.contains(e.target) && !dropdown.contains(e.target)) {
          dropdown.classList.add('hidden');
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupHeroInteractivity);
    } else {
      setupHeroInteractivity();
    }
  </script>
</Layout>
