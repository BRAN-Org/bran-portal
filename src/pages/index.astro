---
import Layout from '../layouts/Layout.astro';
import CalendarWidget from '../components/CalendarWidget.astro';
import ecosystemData from '../data/ecosystem.json';

const { metrics, current_calendar, databases, search_index } = ecosystemData;
const searchIndex = search_index;
---

<Layout title="Dados Abertos para Ciência da Informação e Cientometria" currentPath="/">
  
  <!-- HERO SECTION ESTILO EXACT OUR WORLD IN DATA (Tom de cinza grafite #242429 distinto da navbar #18181B com Rede de Coautoria e Citações Científicas em SVG) -->
  <section class="bg-gradient-to-b from-[#242429] via-[#212126] to-[#1C1C20] text-[#F5F5F4] pt-12 pb-16 sm:pt-16 sm:pb-24 relative overflow-hidden text-center border-b border-white/10 shadow-inner">
    
    <!-- Rede Cientométrica de Coautoria, Citações e Acoplamento Bibliográfico (Pura matemática vetorial com máscara central para máxima legibilidade) -->
    <div class="absolute inset-0 pointer-events-none flex items-center justify-center overflow-hidden">
      <svg class="w-full h-full min-w-[1280px] opacity-45" viewBox="0 0 1600 700" fill="none" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <!-- Máscara de vinheta central: preserva nitidez e contraste absoluto dos textos editoriais e barra de busca -->
          <radialGradient id="heroCenterMaskGrad" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#000000" stop-opacity="0.96" />
            <stop offset="55%" stop-color="#000000" stop-opacity="0.82" />
            <stop offset="78%" stop-color="#000000" stop-opacity="0.3" />
            <stop offset="100%" stop-color="#000000" stop-opacity="0" />
          </radialGradient>
          <mask id="heroNetworkVignette">
            <rect width="1600" height="700" fill="#FFFFFF" />
            <ellipse cx="800" cy="305" rx="440" ry="175" fill="url(#heroCenterMaskGrad)" />
          </mask>

          <!-- Gradientes Cromáticos da Paleta Oficial -->
          <linearGradient id="bronzeLineGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#C87D32" stop-opacity="0.8" />
            <stop offset="100%" stop-color="#A1A1AA" stop-opacity="0.3" />
          </linearGradient>
          <linearGradient id="arcFlowGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#C87D32" stop-opacity="0.85" />
            <stop offset="50%" stop-color="#E59E50" stop-opacity="0.95" />
            <stop offset="100%" stop-color="#C87D32" stop-opacity="0.85" />
          </linearGradient>
          <linearGradient id="arcMutedGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#A1A1AA" stop-opacity="0.6" />
            <stop offset="50%" stop-color="#C87D32" stop-opacity="0.5" />
            <stop offset="100%" stop-color="#A1A1AA" stop-opacity="0.6" />
          </linearGradient>

          <!-- Halos Radiais dos Grandes Hubs Seminais -->
          <radialGradient id="hubHaloBronze" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#C87D32" stop-opacity="0.5" />
            <stop offset="65%" stop-color="#C87D32" stop-opacity="0.18" />
            <stop offset="100%" stop-color="#C87D32" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="hubHaloAmber" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#E59E50" stop-opacity="0.45" />
            <stop offset="70%" stop-color="#E59E50" stop-opacity="0.15" />
            <stop offset="100%" stop-color="#E59E50" stop-opacity="0" />
          </radialGradient>
        </defs>

        <!-- Grafo Mascarado para Respirar no Centro -->
        <g mask="url(#heroNetworkVignette)">
          
          <!-- 1. CAMADA DE FUNDO: ANÉIS DE DENSIDADE E ACOPLAMENTO BIBLIOGRÁFICO -->
          <!-- Anéis Cluster 1 (Oeste) -->
          <circle cx="220" cy="240" r="110" stroke="#C87D32" stroke-width="0.75" stroke-dasharray="3 9" opacity="0.15" />
          <circle cx="220" cy="240" r="190" stroke="#A1A1AA" stroke-width="0.6" stroke-dasharray="4 12" opacity="0.1" />
          
          <!-- Anéis Cluster 2 (Leste) -->
          <circle cx="1380" cy="240" r="120" stroke="#C87D32" stroke-width="0.75" stroke-dasharray="3 9" opacity="0.15" />
          <circle cx="1380" cy="240" r="210" stroke="#A1A1AA" stroke-width="0.6" stroke-dasharray="4 12" opacity="0.1" />

          <!-- Anéis Cluster Sul -->
          <circle cx="340" cy="560" r="90" stroke="#A1A1AA" stroke-width="0.6" stroke-dasharray="2 8" opacity="0.1" />
          <circle cx="1240" cy="560" r="90" stroke="#C87D32" stroke-width="0.6" stroke-dasharray="2 8" opacity="0.1" />

          <!-- 2. ARESTAS DE COAUTORIA E COOCORRÊNCIA (Malha densa inspirada em VOSviewer/Gephi) -->
          <g stroke-linecap="round">
            <!-- Malha Cluster 1: Memória & Organização da Informação (Oeste) -->
            <line x1="220" y1="240" x2="140" y2="180" stroke="#C87D32" stroke-width="2.2" opacity="0.75" />
            <line x1="220" y1="240" x2="120" y2="280" stroke="#A1A1AA" stroke-width="1.6" opacity="0.6" />
            <line x1="220" y1="240" x2="180" y2="340" stroke="#C87D32" stroke-width="2" opacity="0.7" />
            <line x1="220" y1="240" x2="280" y2="310" stroke="#C87D32" stroke-width="2.4" opacity="0.8" />
            <line x1="220" y1="240" x2="310" y2="220" stroke="url(#bronzeLineGrad)" stroke-width="2.2" opacity="0.75" />
            <line x1="220" y1="240" x2="260" y2="150" stroke="#A1A1AA" stroke-width="1.5" opacity="0.55" />
            <!-- Polígono interno Cluster 1 -->
            <line x1="140" y1="180" x2="120" y2="280" stroke="#A1A1AA" stroke-width="1.2" opacity="0.45" />
            <line x1="120" y1="280" x2="180" y2="340" stroke="#A1A1AA" stroke-width="1.3" opacity="0.45" />
            <line x1="180" y1="340" x2="280" y2="310" stroke="#C87D32" stroke-width="1.6" opacity="0.65" />
            <line x1="280" y1="310" x2="310" y2="220" stroke="#C87D32" stroke-width="1.8" opacity="0.7" />
            <line x1="310" y1="220" x2="260" y2="150" stroke="#A1A1AA" stroke-width="1.4" opacity="0.5" />
            <line x1="260" y1="150" x2="140" y2="180" stroke="#A1A1AA" stroke-width="1.2" opacity="0.45" />
            <!-- Satélites Cluster 1 -->
            <line x1="140" y1="180" x2="80" y2="140" stroke="#A1A1AA" stroke-width="1" opacity="0.35" />
            <line x1="140" y1="180" x2="160" y2="110" stroke="#A1A1AA" stroke-width="1.1" opacity="0.4" />
            <line x1="120" y1="280" x2="60" y2="280" stroke="#A1A1AA" stroke-width="1" opacity="0.35" />
            <line x1="120" y1="280" x2="80" y2="350" stroke="#A1A1AA" stroke-width="1" opacity="0.35" />
            <line x1="180" y1="340" x2="120" y2="410" stroke="#C87D32" stroke-width="1.4" opacity="0.55" />
            <line x1="180" y1="340" x2="190" y2="430" stroke="#A1A1AA" stroke-width="1.1" opacity="0.4" />
            <line x1="280" y1="310" x2="340" y2="370" stroke="#C87D32" stroke-width="1.7" opacity="0.65" />
            <line x1="280" y1="310" x2="270" y2="410" stroke="#A1A1AA" stroke-width="1.2" opacity="0.45" />
            <line x1="310" y1="220" x2="380" y2="240" stroke="#C87D32" stroke-width="1.5" opacity="0.6" />
            <line x1="310" y1="220" x2="360" y2="170" stroke="#A1A1AA" stroke-width="1.3" opacity="0.5" />
            <line x1="260" y1="150" x2="240" y2="90" stroke="#A1A1AA" stroke-width="1.1" opacity="0.4" />
            <line x1="260" y1="150" x2="320" y2="110" stroke="#C87D32" stroke-width="1.4" opacity="0.55" />

            <!-- Malha Cluster 2: Periódicos Científicos & Acesso Aberto (Noroeste Superior) -->
            <line x1="480" y1="100" x2="400" y2="80" stroke="#A1A1AA" stroke-width="1.2" opacity="0.45" />
            <line x1="480" y1="100" x2="440" y2="40" stroke="#A1A1AA" stroke-width="1.1" opacity="0.4" />
            <line x1="480" y1="100" x2="530" y2="50" stroke="#C87D32" stroke-width="1.5" opacity="0.6" />
            <line x1="480" y1="100" x2="560" y2="95" stroke="#C87D32" stroke-width="1.8" opacity="0.7" />
            <line x1="480" y1="100" x2="520" y2="160" stroke="#C87D32" stroke-width="1.6" opacity="0.6" />
            <line x1="480" y1="100" x2="430" y2="150" stroke="#A1A1AA" stroke-width="1.3" opacity="0.5" />
            <line x1="400" y1="80" x2="440" y2="40" stroke="#A1A1AA" stroke-width="0.9" opacity="0.3" />
            <line x1="530" y1="50" x2="560" y2="95" stroke="#A1A1AA" stroke-width="1.1" opacity="0.4" />
            <line x1="560" y1="95" x2="520" y2="160" stroke="#C87D32" stroke-width="1.3" opacity="0.55" />
            <line x1="520" y1="160" x2="430" y2="150" stroke="#A1A1AA" stroke-width="1.1" opacity="0.4" />
            <!-- Pontes Cluster 1 -> Cluster 2 -->
            <line x1="310" y1="220" x2="430" y2="150" stroke="url(#bronzeLineGrad)" stroke-width="1.4" opacity="0.55" />
            <line x1="260" y1="150" x2="400" y2="80" stroke="#A1A1AA" stroke-width="1.1" opacity="0.4" />

            <!-- Malha Cluster 3: Bibliometria & Cientometria EBBC (Leste) -->
            <line x1="1380" y1="240" x2="1300" y2="170" stroke="#C87D32" stroke-width="2.3" opacity="0.8" />
            <line x1="1380" y1="240" x2="1440" y2="160" stroke="#C87D32" stroke-width="2" opacity="0.7" />
            <line x1="1380" y1="240" x2="1490" y2="240" stroke="#A1A1AA" stroke-width="1.5" opacity="0.6" />
            <line x1="1380" y1="240" x2="1450" y2="330" stroke="#C87D32" stroke-width="2.4" opacity="0.8" />
            <line x1="1380" y1="240" x2="1360" y2="330" stroke="#C87D32" stroke-width="2" opacity="0.75" />
            <line x1="1380" y1="240" x2="1280" y2="260" stroke="url(#bronzeLineGrad)" stroke-width="2.4" opacity="0.8" />
            <!-- Polígono interno Cluster 3 -->
            <line x1="1300" y1="170" x2="1440" y2="160" stroke="#A1A1AA" stroke-width="1.2" opacity="0.45" />
            <line x1="1440" y1="160" x2="1490" y2="240" stroke="#A1A1AA" stroke-width="1.3" opacity="0.5" />
            <line x1="1490" y1="240" x2="1450" y2="330" stroke="#C87D32" stroke-width="1.7" opacity="0.65" />
            <line x1="1450" y1="330" x2="1360" y2="330" stroke="#C87D32" stroke-width="1.8" opacity="0.7" />
            <line x1="1360" y1="330" x2="1280" y2="260" stroke="#A1A1AA" stroke-width="1.4" opacity="0.55" />
            <line x1="1280" y1="260" x2="1300" y2="170" stroke="#A1A1AA" stroke-width="1.3" opacity="0.5" />
            <!-- Satélites Cluster 3 -->
            <line x1="1300" y1="170" x2="1240" y2="130" stroke="#A1A1AA" stroke-width="1.1" opacity="0.4" />
            <line x1="1300" y1="170" x2="1310" y2="90" stroke="#A1A1AA" stroke-width="1" opacity="0.35" />
            <line x1="1440" y1="160" x2="1410" y2="90" stroke="#A1A1AA" stroke-width="1" opacity="0.35" />
            <line x1="1440" y1="160" x2="1500" y2="120" stroke="#C87D32" stroke-width="1.4" opacity="0.55" />
            <line x1="1490" y1="240" x2="1560" y2="210" stroke="#A1A1AA" stroke-width="1.1" opacity="0.4" />
            <line x1="1490" y1="240" x2="1570" y2="270" stroke="#A1A1AA" stroke-width="1" opacity="0.35" />
            <line x1="1450" y1="330" x2="1530" y2="360" stroke="#C87D32" stroke-width="1.6" opacity="0.6" />
            <line x1="1450" y1="330" x2="1480" y2="410" stroke="#C87D32" stroke-width="1.8" opacity="0.65" />
            <line x1="1360" y1="330" x2="1410" y2="410" stroke="#A1A1AA" stroke-width="1.2" opacity="0.45" />
            <line x1="1360" y1="330" x2="1340" y2="420" stroke="#C87D32" stroke-width="1.5" opacity="0.6" />
            <line x1="1280" y1="260" x2="1210" y2="290" stroke="#A1A1AA" stroke-width="1.3" opacity="0.5" />
            <line x1="1280" y1="260" x2="1220" y2="360" stroke="#C87D32" stroke-width="1.5" opacity="0.55" />

            <!-- Malha Cluster 4: Comunicação Científica ABEC (Nordeste Superior) -->
            <line x1="1120" y1="100" x2="1050" y2="70" stroke="#A1A1AA" stroke-width="1.2" opacity="0.45" />
            <line x1="1120" y1="100" x2="1090" y2="30" stroke="#A1A1AA" stroke-width="1" opacity="0.35" />
            <line x1="1120" y1="100" x2="1180" y2="40" stroke="#A1A1AA" stroke-width="1.1" opacity="0.4" />
            <line x1="1120" y1="100" x2="1210" y2="90" stroke="#C87D32" stroke-width="1.7" opacity="0.65" />
            <line x1="1120" y1="100" x2="1170" y2="150" stroke="#C87D32" stroke-width="1.5" opacity="0.6" />
            <line x1="1120" y1="100" x2="1080" y2="140" stroke="#A1A1AA" stroke-width="1.2" opacity="0.45" />
            <!-- Pontes Cluster 4 -> Cluster 3 -->
            <line x1="1210" y1="90" x2="1300" y2="170" stroke="url(#bronzeLineGrad)" stroke-width="1.5" opacity="0.6" />
            <line x1="1170" y1="150" x2="1280" y2="260" stroke="#A1A1AA" stroke-width="1.2" opacity="0.45" />

            <!-- Malha Cluster 5: Redes de Coautoria ENANCIB / Pós-Graduação (Sudeste Inferior) -->
            <line x1="1240" y1="560" x2="1160" y2="510" stroke="#A1A1AA" stroke-width="1.4" opacity="0.5" />
            <line x1="1240" y1="560" x2="1180" y2="620" stroke="#C87D32" stroke-width="1.7" opacity="0.65" />
            <line x1="1240" y1="560" x2="1270" y2="640" stroke="#C87D32" stroke-width="1.6" opacity="0.6" />
            <line x1="1240" y1="560" x2="1320" y2="580" stroke="#A1A1AA" stroke-width="1.4" opacity="0.5" />
            <line x1="1240" y1="560" x2="1290" y2="490" stroke="#C87D32" stroke-width="1.9" opacity="0.7" />
            <line x1="1160" y1="510" x2="1180" y2="620" stroke="#A1A1AA" stroke-width="1.1" opacity="0.35" />
            <line x1="1270" y1="640" x2="1320" y2="580" stroke="#A1A1AA" stroke-width="1.1" opacity="0.35" />
            <line x1="1320" y1="580" x2="1290" y2="490" stroke="#C87D32" stroke-width="1.4" opacity="0.55" />
            <!-- Satélites Cluster 5 -->
            <line x1="1160" y1="510" x2="1100" y2="530" stroke="#A1A1AA" stroke-width="1" opacity="0.35" />
            <line x1="1180" y1="620" x2="1130" y2="640" stroke="#A1A1AA" stroke-width="1" opacity="0.3" />
            <line x1="1270" y1="640" x2="1310" y2="660" stroke="#A1A1AA" stroke-width="1" opacity="0.3" />
            <line x1="1320" y1="580" x2="1370" y2="590" stroke="#A1A1AA" stroke-width="1.1" opacity="0.35" />
            <!-- Conexões Cluster 3 -> Cluster 5 (Interdisciplinaridade) -->
            <line x1="1360" y1="330" x2="1290" y2="490" stroke="url(#bronzeLineGrad)" stroke-width="1.6" opacity="0.6" />
            <line x1="1480" y1="410" x2="1320" y2="580" stroke="#A1A1AA" stroke-width="1.2" opacity="0.45" />

            <!-- Malha Cluster 6: Redes Regionais & Preservação Digital (Sudoeste Inferior) -->
            <line x1="340" y1="560" x2="260" y2="520" stroke="#A1A1AA" stroke-width="1.3" opacity="0.45" />
            <line x1="340" y1="560" x2="280" y2="620" stroke="#C87D32" stroke-width="1.6" opacity="0.6" />
            <line x1="340" y1="560" x2="370" y2="640" stroke="#C87D32" stroke-width="1.5" opacity="0.55" />
            <line x1="340" y1="560" x2="420" y2="590" stroke="#A1A1AA" stroke-width="1.3" opacity="0.45" />
            <line x1="340" y1="560" x2="390" y2="500" stroke="#C87D32" stroke-width="1.8" opacity="0.65" />
            <line x1="260" y1="520" x2="280" y2="620" stroke="#A1A1AA" stroke-width="1" opacity="0.35" />
            <line x1="370" y1="640" x2="420" y2="590" stroke="#A1A1AA" stroke-width="1" opacity="0.35" />
            <line x1="420" y1="590" x2="390" y2="500" stroke="#C87D32" stroke-width="1.4" opacity="0.5" />
            <!-- Satélites Cluster 6 -->
            <line x1="260" y1="520" x2="210" y2="540" stroke="#A1A1AA" stroke-width="1" opacity="0.3" />
            <line x1="280" y1="620" x2="240" y2="650" stroke="#A1A1AA" stroke-width="0.9" opacity="0.3" />
            <line x1="420" y1="590" x2="460" y2="610" stroke="#A1A1AA" stroke-width="1" opacity="0.35" />
            <!-- Conexões Cluster 1 -> Cluster 6 -->
            <line x1="180" y1="340" x2="260" y2="520" stroke="#A1A1AA" stroke-width="1.2" opacity="0.4" />
            <line x1="280" y1="310" x2="390" y2="500" stroke="url(#bronzeLineGrad)" stroke-width="1.5" opacity="0.6" />

            <!-- Linhas de Amarração do Dossel Superior e Inferior -->
            <line x1="560" y1="95" x2="680" y2="55" stroke="url(#bronzeLineGrad)" stroke-width="1.2" opacity="0.5" />
            <line x1="680" y1="55" x2="800" y2="38" stroke="#C87D32" stroke-width="1.2" opacity="0.5" />
            <line x1="800" y1="38" x2="920" y2="55" stroke="#C87D32" stroke-width="1.2" opacity="0.5" />
            <line x1="920" y1="55" x2="1050" y2="70" stroke="url(#bronzeLineGrad)" stroke-width="1.2" opacity="0.5" />

            <line x1="420" y1="590" x2="580" y2="630" stroke="#A1A1AA" stroke-width="1.1" opacity="0.4" />
            <line x1="580" y1="630" x2="720" y2="655" stroke="#C87D32" stroke-width="1.2" opacity="0.45" />
            <line x1="720" y1="655" x2="880" y2="655" stroke="#C87D32" stroke-width="1.2" opacity="0.45" />
            <line x1="880" y1="655" x2="1020" y2="630" stroke="#A1A1AA" stroke-width="1.1" opacity="0.4" />
            <line x1="1020" y1="630" x2="1160" y2="510" stroke="#A1A1AA" stroke-width="1.1" opacity="0.4" />
          </g>

          <!-- 3. FLUXOS TRANSVERSAIS DE CITAÇÃO CIENTÍFICA (Arcos harmônicos de Bézier com pulso de partículas contínuo) -->
          <g fill="none">
            <!-- Arco Superior 1: Ponte Epistemológica Memória <-> Cientometria (Alto alcance) -->
            <path d="M 310 220 Q 800 35 1280 260" stroke="url(#arcFlowGrad)" stroke-width="1.8" class="citation-flow-line" opacity="0.8" />
            
            <!-- Arco Superior 2: Ponte Interperiódica DataGramaZero <-> ABEC -->
            <path d="M 560 95 Q 840 60 1050 70" stroke="url(#arcMutedGrad)" stroke-width="1.4" class="citation-flow-fast" opacity="0.65" />
            
            <!-- Arco Inferior: Integração de Acervos Sul-Sudeste <-> EBBC/ENANCIB -->
            <path d="M 420 590 Q 800 660 1160 510" stroke="url(#arcFlowGrad)" stroke-width="1.6" class="citation-flow-line" opacity="0.75" />
            
            <!-- Arco Curvo Oeste: Fluxo Histórico CBBD -> Encontros Temáticos -->
            <path d="M 260 150 Q 180 340 280 620" stroke="#C87D32" stroke-width="1.2" stroke-dasharray="4 6" opacity="0.5" />
            
            <!-- Arco Curvo Leste: Acoplamento Metodológico Citacional Garfield/Price -> EBBC -->
            <path d="M 1440 160 Q 1520 370 1320 580" stroke="#C87D32" stroke-width="1.2" stroke-dasharray="4 6" opacity="0.55" />
          </g>

          <!-- 4. HALOS E BEACONS RADIAIS DOS HUBS SEMINAIS -->
          <circle cx="220" cy="240" r="26" fill="url(#hubHaloBronze)" class="node-hub-breathe" />
          <circle cx="1380" cy="240" r="28" fill="url(#hubHaloBronze)" class="node-hub-breathe" />
          <circle cx="480" cy="100" r="20" fill="url(#hubHaloAmber)" class="node-hub-breathe" />
          <circle cx="1120" cy="100" r="20" fill="url(#hubHaloAmber)" class="node-hub-breathe" />
          <circle cx="1240" cy="560" r="22" fill="url(#hubHaloBronze)" class="node-hub-breathe" />
          <circle cx="340" cy="560" r="22" fill="url(#hubHaloBronze)" class="node-hub-breathe" />

          <!-- Ondas de Beacon Expansivas -->
          <circle cx="220" cy="240" r="10" stroke="#C87D32" stroke-width="1.2" fill="none" class="halo-wave" />
          <circle cx="1380" cy="240" r="10" stroke="#C87D32" stroke-width="1.2" fill="none" class="halo-wave" />
          <circle cx="1240" cy="560" r="9" stroke="#C87D32" stroke-width="1" fill="none" class="halo-wave" />
          <circle cx="340" cy="560" r="9" stroke="#C87D32" stroke-width="1" fill="none" class="halo-wave" />

          <!-- 5. NÓS HIERÁRQUICOS DA REDE CIENTOMÉTRICA (Distribuição de Pareto por Grau de Centralidade) -->
          <!-- Tier 1: Grandes Hubs Seminais Canônicos (Off-white com anel Bronze e miolo ativo) -->
          <circle cx="220" cy="240" r="8.5" fill="#F5F5F4" stroke="#C87D32" stroke-width="2.5" />
          <circle cx="220" cy="240" r="3.2" fill="#C87D32" />

          <circle cx="1380" cy="240" r="9" fill="#F5F5F4" stroke="#C87D32" stroke-width="2.5" />
