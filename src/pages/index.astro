  <!-- Script para a Busca Instantânea no Hero e Formulário de Newsletter -->
  <script define:vars={{ searchIndex }}>
    window.__BRAN_SEARCH_INDEX__ = searchIndex;

    function setupHeroInteractivity() {
      const input = document.getElementById('hero-search-input');
      const dropdown = document.getElementById('hero-results-dropdown');
      const form = document.getElementById('newsletter-form');
      const successMsg = document.getElementById('newsletter-success');

      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          successMsg.classList.remove('hidden');
          form.reset();
        });
      }

      if (!input || !dropdown) return;

      function normalize(str) {
        return (str || '')
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .trim();
      }

      function handleSearch() {
        const q = normalize(input.value);

        if (!q) {
          dropdown.classList.add('hidden');
          dropdown.innerHTML = '';
          return;
        }

        const matches = window.__BRAN_SEARCH_INDEX__.filter(item => {
          const nameNorm = normalize(item.name);
          const siglaNorm = normalize(item.sigla);
          return siglaNorm.includes(q) || nameNorm.includes(q);
        });

        dropdown.classList.remove('hidden');

        if (matches.length > 0) {
          dropdown.innerHTML = matches.map(item => {
            const isIndexed = item.status === 'INDEXED';
            return `
              <div class="p-3.5 hover:bg-white transition-colors">
                <div class="flex items-center justify-between gap-2">
                  <div class="flex items-center gap-2">
                    <span class="px-2 py-0.5 text-[10px] font-bold font-mono rounded ${isIndexed ? 'bg-[#C87D32]/10 text-[#C87D32] border border-[#C87D32]/30' : 'bg-[#18181B]/10 text-[#18181B]'}">
                      ${isIndexed ? '✓ INDEXADO' : '⏳ NO BACKLOG'}
                    </span>
                    <span class="text-xs font-bold text-[#18181B] font-serif">${item.sigla}</span>
                    <span class="text-xs text-stone-600 truncate max-w-xs sm:max-w-md">${item.name}</span>
                  </div>
                  ${item.records ? `
                    <span class="text-xs font-mono font-bold text-[#18181B] shrink-0">
                      ${item.records.toLocaleString('pt-BR')} artigos
                    </span>
                  ` : ''}
                </div>
                <div class="mt-2 flex items-center justify-between text-xs">
                  <span class="text-[#A1A1AA] font-mono text-[11px]">${item.type} • ${item.coverage}</span>
                  <div class="flex items-center gap-2">
                    ${isIndexed ? `
                      <a href="${item.slug}" class="font-bold text-[#C87D32] hover:underline">
                        Ver Detalhes →
                      </a>
                    ` : `
                      <a href="${item.suggest_url || 'https://github.com/BRAN-Org/portal/issues/new'}" target="_blank" rel="noopener noreferrer" class="font-bold text-[#C87D32] hover:underline">
                        Sugerir / Acompanhar ↗
                      </a>
                    `}
                  </div>
                </div>
              </div>
            `;
          }).join('');
        } else {
          const issueTitle = encodeURIComponent(`Sugestão de Base: ${input.value.trim()}`);
          dropdown.innerHTML = `
            <div class="p-4 bg-[#F5F5F4] text-[#18181B] border-l-4 border-[#C87D32] space-y-2">
              <div class="font-bold text-xs font-serif text-[#18181B]">
                Esta fonte ainda não está indexada na BRAN Org
              </div>
              <p class="text-xs text-stone-600">
                Não encontramos registros para "${input.value}". Deseja propor a curadoria deste acervo?
              </p>
              <div class="pt-1">
                <a 
                  href="https://github.com/BRAN-Org/portal/issues/new?title=${issueTitle}&body=Por+favor+informe+a+URL+oficial+dos+anais+ou+peri%C3%B3dico+e+se+possui+DOI+ou+OJS." 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-[#C87D32] text-white font-bold text-xs hover:bg-[#b06a28] transition-colors"
                >
                  + Propor Inclusão desta Base no GitHub
                </a>
              </div>
            </div>
          `;
        }
      }

      input.addEventListener('input', handleSearch);

      // Fecha dropdown ao clicar fora
      document.addEventListener('click', (e) => {
        if (!input.contains(e.target) && !dropdown.contains(e.target)) {
          dropdown.classList.add('hidden');
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupHeroInteractivity);
    } else {
      setupHeroInteractivity();
    }
  </script>
