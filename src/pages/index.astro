---
import Layout from '../layouts/Layout.astro';
import CalendarWidget from '../components/CalendarWidget.astro';
import ecosystemData from '../data/ecosystem.json';

const { metrics, current_calendar, databases, search_index } = ecosystemData;
const searchIndex = search_index;
---

<Layout title="Dados Abertos para Ciência da Informação e Cientometria" currentPath="/">
  
  <!-- HERO SECTION ESTILO EXACT OUR WORLD IN DATA (Tom de cinza grafite #242429 distinto da navbar #18181B com Rede de Coautoria e Citações Científicas em SVG) -->
  <section class="bg-gradient-to-b from-[#242429] via-[#212126] to-[#1C1C20] text-[#F5F5F4] pt-12 pb-16 sm:pt-16 sm:pb-24 relative overflow-hidden text-center border-b border-white/10 shadow-inner">
    
    <!-- Rede de Coautoria e Citações Científicas (0 kB externo, pura matemática vetorial com arcos animados) -->
    <div class="absolute inset-0 pointer-events-none flex items-center justify-center overflow-hidden">
      <svg class="w-full h-full min-w-[1280px] opacity-35" viewBox="0 0 1600 700" fill="none" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <!-- Setas Direcionais para Fluxos de Citação Científica -->
          <marker id="citArrowBronze" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1.5 L 9 5 L 0 8.5 z" fill="#C87D32" opacity="0.9" />
          </marker>
          <marker id="citArrowMuted" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1.5 L 9 5 L 0 8.5 z" fill="#A1A1AA" opacity="0.75" />
          </marker>

          <!-- Gradientes de Arestas -->
          <linearGradient id="bronzeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#C87D32" stop-opacity="0.8" />
            <stop offset="100%" stop-color="#A1A1AA" stop-opacity="0.3" />
          </linearGradient>
          <linearGradient id="mutedGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#A1A1AA" stop-opacity="0.4" />
            <stop offset="100%" stop-color="#18181B" stop-opacity="0.1" />
          </linearGradient>

          <!-- Halo Radial dos Hubs Seminais -->
          <radialGradient id="hubHalo" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#C87D32" stop-opacity="0.45" />
            <stop offset="100%" stop-color="#C87D32" stop-opacity="0" />
          </radialGradient>
        </defs>

        <!-- 1. CAMADA DE FUNDO: ANÉIS DE ACOPLAMENTO BIBLIOGRÁFICO & DENSIDADE TEMÁTICA -->
        <circle cx="800" cy="350" r="280" stroke="#C87D32" stroke-width="0.75" stroke-dasharray="3 9" opacity="0.18"></circle>
        <circle cx="800" cy="350" r="480" stroke="#A1A1AA" stroke-width="0.75" stroke-dasharray="4 12" opacity="0.14"></circle>
        <circle cx="800" cy="350" r="680" stroke="#A1A1AA" stroke-width="0.5" stroke-dasharray="2 16" opacity="0.10"></circle>

        <!-- 2. ARESTAS DE COAUTORIA (Linhas sólidas com espessuras proporcionais à colaboração acadêmica) -->
        <!-- Cluster A (Esquerda: GT-2 Organização & Recuperação da Informação / CBBD) -->
        <g stroke-linecap="round">
          <line x1="180" y1="180" x2="100" y2="120" stroke="#A1A1AA" stroke-width="1.2" opacity="0.45" />
          <line x1="180" y1="180" x2="110" y2="240" stroke="#A1A1AA" stroke-width="1.8" opacity="0.5" />
          <line x1="180" y1="180" x2="250" y2="110" stroke="#C87D32" stroke-width="1.5" opacity="0.6" />
          <line x1="180" y1="180" x2="260" y2="230" stroke="#C87D32" stroke-width="2.2" opacity="0.7" />
          <line x1="100" y1="120" x2="250" y2="110" stroke="#A1A1AA" stroke-width="0.9" opacity="0.35" />
          <line x1="110" y1="240" x2="260" y2="230" stroke="#A1A1AA" stroke-width="1.4" opacity="0.45" />
          <line x1="260" y1="230" x2="340" y2="290" stroke="url(#bronzeGrad)" stroke-width="1.6" opacity="0.65" />
          <line x1="340" y1="290" x2="280" y2="370" stroke="#A1A1AA" stroke-width="1.4" opacity="0.45" />
          <line x1="340" y1="290" x2="390" y2="380" stroke="#A1A1AA" stroke-width="1.1" opacity="0.4" />
          <line x1="280" y1="370" x2="150" y2="420" stroke="#C87D32" stroke-width="1.5" opacity="0.55" />
          <line x1="150" y1="420" x2="90" y2="490" stroke="#A1A1AA" stroke-width="1.2" opacity="0.45" />
          <line x1="150" y1="420" x2="210" y2="490" stroke="#C87D32" stroke-width="1.8" opacity="0.6" />
          <line x1="150" y1="420" x2="130" y2="570" stroke="#A1A1AA" stroke-width="1" opacity="0.35" />
          <line x1="90" y1="490" x2="210" y2="490" stroke="#A1A1AA" stroke-width="1.1" opacity="0.35" />

          <!-- Cluster B (Centro Superior: Periódicos & Comunicação Científica - DataGramaZero e ABEC) -->
          <line x1="560" y1="100" x2="490" y2="50" stroke="#A1A1AA" stroke-width="1.2" opacity="0.45" />
          <line x1="560" y1="100" x2="640" y2="55" stroke="#C87D32" stroke-width="1.5" opacity="0.6" />
          <line x1="560" y1="100" x2="440" y2="180" stroke="#C87D32" stroke-width="2" opacity="0.65" />
          <line x1="880" y1="80" x2="820" y2="45" stroke="#A1A1AA" stroke-width="1.2" opacity="0.4" />
          <line x1="880" y1="80" x2="960" y2="55" stroke="#C87D32" stroke-width="1.4" opacity="0.55" />
          <line x1="880" y1="80" x2="770" y2="110" stroke="#A1A1AA" stroke-width="1.1" opacity="0.35" />

          <!-- Cluster C (Direita: GT-7 Cientometria, Bibliometria, EBBC e Indicadores de C&T) -->
          <line x1="1320" y1="150" x2="1230" y2="90" stroke="#A1A1AA" stroke-width="1.3" opacity="0.45" />
          <line x1="1320" y1="150" x2="1420" y2="95" stroke="#C87D32" stroke-width="1.5" opacity="0.6" />
          <line x1="1320" y1="150" x2="1440" y2="210" stroke="#A1A1AA" stroke-width="1.4" opacity="0.45" />
          <line x1="1320" y1="150" x2="1190" y2="200" stroke="#C87D32" stroke-width="2.2" opacity="0.75" />
          <line x1="1190" y1="200" x2="1110" y2="140" stroke="#A1A1AA" stroke-width="1.2" opacity="0.4" />
          <line x1="1190" y1="200" x2="1130" y2="270" stroke="#A1A1AA" stroke-width="1.5" opacity="0.5" />
          <line x1="1190" y1="200" x2="1280" y2="320" stroke="url(#bronzeGrad)" stroke-width="2.4" opacity="0.8" />
          <line x1="1280" y1="320" x2="1200" y2="380" stroke="#A1A1AA" stroke-width="1.8" opacity="0.55" />
          <line x1="1280" y1="320" x2="1370" y2="390" stroke="#C87D32" stroke-width="2" opacity="0.7" />
          <line x1="1280" y1="320" x2="1440" y2="320" stroke="#A1A1AA" stroke-width="1.3" opacity="0.45" />
          <line x1="1280" y1="320" x2="1290" y2="460" stroke="#C87D32" stroke-width="1.6" opacity="0.6" />
          <line x1="1370" y1="390" x2="1460" y2="460" stroke="#C87D32" stroke-width="1.8" opacity="0.65" />
          <line x1="1460" y1="460" x2="1530" y2="420" stroke="#A1A1AA" stroke-width="1.2" opacity="0.4" />
          <line x1="1460" y1="460" x2="1520" y2="520" stroke="#A1A1AA" stroke-width="1.1" opacity="0.35" />

          <!-- Cluster D (Subredes Inferiores de Colaboração Institucional) -->
          <line x1="320" y1="580" x2="420" y2="610" stroke="#A1A1AA" stroke-width="1.4" opacity="0.45" />
          <line x1="420" y1="610" x2="490" y2="570" stroke="#C87D32" stroke-width="1.6" opacity="0.55" />
          <line x1="320" y1="580" x2="260" y2="630" stroke="#A1A1AA" stroke-width="1" opacity="0.35" />
          <line x1="1080" y1="580" x2="1160" y2="620" stroke="#C87D32" stroke-width="1.8" opacity="0.6" />
          <line x1="1160" y1="620" x2="1250" y2="580" stroke="#A1A1AA" stroke-width="1.3" opacity="0.4" />
        </g>

        <!-- 3. FLUXOS DE CITAÇÃO CIENTÍFICA (Arcos de Bézier com setas direcionais e pulsos animados) -->
        <g fill="none">
          <!-- Citação 1: EBBC cita Price (1965) - Clássico de Redes de Citação -->
          <path d="M 1280 320 Q 1240 220 1314 158" stroke="#C87D32" stroke-width="1.8" marker-end="url(#citArrowBronze)" class="citation-flow-line" opacity="0.85" />
          
          <!-- Citação 2: GT-7 ENANCIB cita Garfield (Fator de Impacto) transversalmente -->
          <path d="M 440 180 Q 800 30 1182 195" stroke="#C87D32" stroke-width="1.6" marker-end="url(#citArrowBronze)" class="citation-flow-line" opacity="0.8" />
          
          <!-- Citação 3: DataGramaZero cita Saracevic (1995) seminal -->
          <path d="M 560 100 Q 360 60 188 174" stroke="#A1A1AA" stroke-width="1.4" marker-end="url(#citArrowMuted)" class="citation-flow-fast" opacity="0.75" />
          
          <!-- Citação 4: CBBD cita Shera & Otlet seminal -->
          <path d="M 150 420 Q 230 400 334 298" stroke="#C87D32" stroke-width="1.6" marker-end="url(#citArrowBronze)" class="citation-flow-line" opacity="0.8" />
          
          <!-- Citação 5: EBBC cita Leis Bibliométricas de Bradford/Lotka -->
          <path d="M 1280 320 Q 1380 340 1454 452" stroke="#C87D32" stroke-width="1.5" marker-end="url(#citArrowBronze)" class="citation-flow-line" opacity="0.8" />
          
          <!-- Citação 6: Acoplamento Bibliográfico entre Redes do Sul-Sudeste e EBBC -->
          <path d="M 490 570 Q 800 660 1072 585" stroke="#A1A1AA" stroke-width="1.3" marker-end="url(#citArrowMuted)" stroke-dasharray="5 7" opacity="0.65" />
          
          <!-- Citação 7: Conexão Interperiódica ABEC com DataGramaZero -->
          <path d="M 880 80 Q 720 140 572 105" stroke="#C87D32" stroke-width="1.4" marker-end="url(#citArrowBronze)" class="citation-flow-fast" opacity="0.7" />

          <!-- Citação 8: Saracevic citado por GT-2 Organização -->
          <path d="M 260 230 Q 210 240 186 190" stroke="#C87D32" stroke-width="1.4" marker-end="url(#citArrowBronze)" opacity="0.75" />
        </g>

        <!-- 4. NÓS CIENTÍFICOS HIERÁRQUICOS (Autores, Artigos Seminais e Eventos) -->
        <!-- Halos de Radiação nos Hubs Centrais -->
        <circle cx="180" cy="180" r="16" fill="url(#hubHalo)" class="node-hub-pulse"></circle>
        <circle cx="1320" cy="150" r="18" fill="url(#hubHalo)" class="node-hub-pulse"></circle>
        <circle cx="1280" cy="320" r="16" fill="url(#hubHalo)" class="node-hub-pulse"></circle>

        <!-- Ondas de Beacon nos Hubs Seminais -->
        <circle cx="180" cy="180" r="8" stroke="#C87D32" stroke-width="1" fill="none" class="halo-wave"></circle>
        <circle cx="1320" cy="150" r="8" stroke="#C87D32" stroke-width="1" fill="none" class="halo-wave"></circle>
        <circle cx="1280" cy="320" r="8" stroke="#C87D32" stroke-width="1" fill="none" class="halo-wave"></circle>

        <!-- Círculos dos Nós (Sized by In-degree / Citações) -->
        <!-- Hubs Principais (Bronze #C87D32 & Off-white #F5F5F4) -->
        <circle cx="180" cy="180" r="8" fill="#F5F5F4" stroke="#C87D32" stroke-width="2.5" />
        <circle cx="260" cy="230" r="6" fill="#C87D32" stroke="#18181B" stroke-width="1.5" />
        <circle cx="340" cy="290" r="7" fill="#C87D32" stroke="#18181B" stroke-width="1.5" />
        <circle cx="150" cy="420" r="7.5" fill="#F5F5F4" stroke="#C87D32" stroke-width="2" />
        <circle cx="560" cy="100" r="7" fill="#F5F5F4" stroke="#C87D32" stroke-width="2" />
        <circle cx="440" cy="180" r="6.5" fill="#C87D32" stroke="#18181B" stroke-width="1.5" />
        <circle cx="880" cy="80" r="6.5" fill="#C87D32" stroke="#18181B" stroke-width="1.5" />
        <circle cx="1320" cy="150" r="8.5" fill="#F5F5F4" stroke="#C87D32" stroke-width="2.5" />
        <circle cx="1190" cy="200" r="7.5" fill="#C87D32" stroke="#18181B" stroke-width="1.5" />
        <circle cx="1280" cy="320" r="8" fill="#F5F5F4" stroke="#C87D32" stroke-width="2.5" />
        <circle cx="1460" cy="460" r="6.5" fill="#C87D32" stroke="#18181B" stroke-width="1.5" />
        <circle cx="1160" cy="620" r="6" fill="#C87D32" stroke="#18181B" stroke-width="1.5" />
        <circle cx="490" cy="570" r="5.5" fill="#C87D32" stroke="#18181B" stroke-width="1.5" />

        <!-- Nós Secundários / Autores e Artigos Satélites (Muted #A1A1AA) -->
        <circle cx="100" cy="120" r="4" fill="#A1A1AA" opacity="0.8" />
        <circle cx="110" cy="240" r="5" fill="#A1A1AA" opacity="0.8" />
        <circle cx="250" cy="110" r="4.5" fill="#A1A1AA" opacity="0.8" />
        <circle cx="280" cy="370" r="4.5" fill="#A1A1AA" opacity="0.8" />
        <circle cx="390" cy="380" r="4" fill="#A1A1AA" opacity="0.8" />
        <circle cx="90" cy="490" r="4" fill="#A1A1AA" opacity="0.8" />
        <circle cx="210" cy="490" r="5" fill="#A1A1AA" opacity="0.8" />
        <circle cx="130" cy="570" r="3.5" fill="#A1A1AA" opacity="0.7" />
        <circle cx="490" cy="50" r="4" fill="#A1A1AA" opacity="0.8" />
        <circle cx="640" cy="55" r="4" fill="#A1A1AA" opacity="0.8" />
        <circle cx="820" cy="45" r="3.5" fill="#A1A1AA" opacity="0.7" />
        <circle cx="960" cy="55" r="4" fill="#A1A1AA" opacity="0.8" />
        <circle cx="770" cy="110" r="3.5" fill="#A1A1AA" opacity="0.7" />
        <circle cx="1230" cy="90" r="4.5" fill="#A1A1AA" opacity="0.8" />
        <circle cx="1420" cy="95" r="4" fill="#A1A1AA" opacity="0.8" />
        <circle cx="1440" cy="210" r="5" fill="#A1A1AA" opacity="0.8" />
        <circle cx="1110" cy="140" r="4" fill="#A1A1AA" opacity="0.8" />
        <circle cx="1130" cy="270" r="4.5" fill="#A1A1AA" opacity="0.8" />
        <circle cx="1200" cy="380" r="5" fill="#A1A1AA" opacity="0.8" />
        <circle cx="1370" cy="390" r="5" fill="#A1A1AA" opacity="0.8" />
        <circle cx="1440" cy="320" r="4.5" fill="#A1A1AA" opacity="0.8" />
        <circle cx="1290" cy="460" r="4" fill="#A1A1AA" opacity="0.8" />
        <circle cx="1530" cy="420" r="4" fill="#A1A1AA" opacity="0.7" />
        <circle cx="1520" cy="520" r="3.5" fill="#A1A1AA" opacity="0.7" />
        <circle cx="320" cy="580" r="4.5" fill="#A1A1AA" opacity="0.7" />
        <circle cx="420" cy="610" r="4" fill="#A1A1AA" opacity="0.7" />
        <circle cx="260" cy="630" r="3" fill="#A1A1AA" opacity="0.6" />
        <circle cx="1080" cy="580" r="4.5" fill="#A1A1AA" opacity="0.7" />
        <circle cx="1250" cy="580" r="4" fill="#A1A1AA" opacity="0.7" />

        <!-- 5. RÓTULOS CIENTÍFICOS MONOESPAÇADOS (Legibilidade tipográfica estilo periódicos de alto impacto) -->
        <g font-family="monospace" font-size="10" font-weight="600" letter-spacing="0.04em">
          <!-- Cluster Teórico & Organização -->
          <text x="195" y="176" fill="#F5F5F4" opacity="0.9">Saracevic (1995) <tspan fill="#C87D32" font-size="8.5">[cit: 842]</tspan></text>
          <text x="274" y="226" fill="#A1A1AA" opacity="0.85">GT-2 Org. Conhecimento</text>
          <text x="354" y="286" fill="#C87D32" opacity="0.9">Shera &amp; Otlet <tspan fill="#A1A1AA" font-size="8">[Seminal]</tspan></text>
          <text x="165" y="416" fill="#F5F5F4" opacity="0.9">CBBD · Preservação</text>
          <text x="122" y="260" fill="#A1A1AA" font-size="8.5" opacity="0.6">coautoria: k=5</text>

          <!-- Cluster Periódicos -->
          <text x="575" y="96" fill="#F5F5F4" opacity="0.9">DataGramaZero <tspan fill="#C87D32" font-size="8">[1999-2015]</tspan></text>
          <text x="895" y="76" fill="#A1A1AA" opacity="0.85">ABEC · Comunicação</text>
          <text x="455" y="175" fill="#C87D32" opacity="0.85">GT-7 Comunicação &amp; Acesso Aberto</text>

          <!-- Cluster Cientometria / Bibliometria -->
          <text x="1335" y="146" fill="#F5F5F4" opacity="0.9">Price (1965) <tspan fill="#C87D32" font-size="8.5">[cit: 1.8k]</tspan></text>
          <text x="1205" y="195" fill="#A1A1AA" opacity="0.85">Garfield · ISI WoS</text>
          <text x="1295" y="316" fill="#F5F5F4" opacity="0.9">EBBC · Bibliometria <tspan fill="#C87D32" font-size="8.5">[k=8]</tspan></text>
          <text x="1475" y="456" fill="#A1A1AA" opacity="0.85">Leis de Bradford &amp; Lotka</text>
          <text x="1215" y="400" fill="#C87D32" font-size="8.5" opacity="0.75">acoplamento bibliográfico</text>

          <!-- Indicadores Metodológicos Inferiores -->
          <text x="505" y="565" fill="#A1A1AA" font-size="8.5" opacity="0.6">rede regional sul-sudeste</text>
          <text x="1175" y="615" fill="#A1A1AA" font-size="8.5" opacity="0.6">colaboração multicêntrica</text>
        </g>
      </svg>
    </div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 relative z-10">
      
      <!-- Legenda Científica Discreta Estilo OWID / Nature Index -->
      <div class="inline-flex items-center gap-3 px-3 py-1 bg-black/40 border border-white/10 rounded-full text-[10px] font-mono text-[#A1A1AA] mb-4 backdrop-blur-xs">
        <span class="inline-flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-[#C87D32]"></span> Nós de Autor / Artigo</span>
        <span class="hidden sm:inline-flex items-center gap-1.5"><span class="w-3.5 h-[1.5px] bg-[#A1A1AA]/70"></span> Coautoria</span>
        <span class="inline-flex items-center gap-1.5"><span class="w-3.5 border-b border-dashed border-[#C87D32]"></span> Citação Científica ⇢</span>
      </div>

      <!-- Headline Editorial Dourado/Bronze (#C87D32) -->
      <h1 class="text-3xl sm:text-5xl font-bold font-serif text-[#F5F5F4] leading-[1.18] tracking-tight">

        Dados e pesquisas para resgatar e preservar a <span class="text-[#C87D32] italic">memória científica</span> brasileira.
      </h1>

      <div class="mt-3">
        <a href="/about" class="text-xs sm:text-sm text-[#A1A1AA] hover:text-[#C87D32] underline underline-offset-4 font-sans font-medium transition-colors">
          Conheça nossa missão →
        </a>
      </div>

      <!-- Barra de Busca Centralizada com Autocomplete / Verificador Instantâneo -->
      <div class="mt-8 max-w-2xl mx-auto relative text-left">
        <div class="relative flex items-center">
          <input 
            type="text" 
            id="hero-search-input"
            placeholder='Buscar periódico ou evento: "DataGramaZero", "ENANCIB", "EBBC", "CBBD", "SNBU"...' 
            class="w-full pl-5 pr-12 py-3.5 sm:py-4 text-sm sm:text-base text-[#18181B] bg-[#F5F5F4] rounded-md shadow-2xl focus:outline-none focus:ring-2 focus:ring-[#C87D32] focus:bg-white font-sans transition-all placeholder:text-[#A1A1AA]"
            autocomplete="off"
          />
          <div class="absolute right-4 text-[#A1A1AA] pointer-events-none">
            <svg class="w-5 h-5 text-[#C87D32]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          </div>
        </div>

        <!-- Dropdown Instantâneo de Resultados (Existe na BRAN?) -->
        <div id="hero-results-dropdown" class="hidden absolute left-0 right-0 mt-2 bg-[#F5F5F4] text-[#18181B] rounded-lg shadow-2xl border border-[#A1A1AA]/30 overflow-hidden z-50 max-h-96 overflow-y-auto divide-y divide-[#A1A1AA]/20">
          <!-- Injetado dinamicamente via JS -->
        </div>
      </div>

      <!-- AS 4 BOLINHAS DE INDICADORES QUANTITATIVOS (Paleta Graphite, Bronze e Muted) -->
      <div class="mt-7 flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs text-[#F5F5F4]">
        <!-- Bolinha 1: Artigos Catalogados -->
        <a href="/databases" class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full bg-white/10 hover:bg-white/20 hover:border-[#C87D32] border border-white/15 backdrop-blur-xs font-mono transition-colors">
          <svg class="w-3.5 h-3.5 text-[#C87D32]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          <span>{metrics.total_records.toLocaleString('pt-BR')} artigos catalogados</span>
        </a>

        <!-- Bolinha 2: Eventos / Conferências -->
        <a href="/databases?type=Conferência" class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full bg-white/10 hover:bg-white/20 hover:border-[#C87D32] border border-white/15 backdrop-blur-xs font-mono transition-colors">
