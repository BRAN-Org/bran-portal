---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description?: string;
  activeDoc: string;
}

const { title, description, activeDoc } = Astro.props;

const docNav = [
  { slug: '/docs', label: '1. Visão Geral da BRAN Org', id: 'intro' },
  { slug: '/docs/protocolo-crona', label: '2. Protocolo CRONA & Auditoria', id: 'crona' },
  { slug: '/docs/esquemas', label: '3. Esquemas JSON Canônicos', id: 'schemas' },
  { slug: '/docs/api', label: '4. Especificação da API REST', id: 'api' },
  { slug: '/docs/curadoria', label: '5. Guia de Ingestão & DOIs', id: 'curation' },
  { slug: '/docs/zenodo', label: '6. Preservação no Zenodo', id: 'zenodo' }
];
---

<Layout title={`${title} — Documentação`} description={description} currentPath="/docs">
  <div class="border-b border-white/10 bg-[#18181B] text-[#F5F5F4] py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#C87D32] mb-1 font-mono">
        <span>Documentação Técnica & Governança</span>
      </div>
      <h1 class="text-3xl font-bold font-serif text-[#F5F5F4] tracking-tight">
        Documentação Oficial da BRAN
      </h1>
      <p class="text-sm text-stone-300 mt-1 max-w-2xl font-sans">
        Manuais técnicos, especificações de dados abertos, conformidade com os esquemas JSON canônicos e protocolos de auditoria criptográfica.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <!-- Sidebar de Navegação de Docs -->
      <aside class="lg:col-span-3 sticky top-24 bg-white p-5 rounded-xl border border-[#A1A1AA]/30 shadow-2xs">
        <h4 class="text-xs uppercase tracking-wider text-[#A1A1AA] font-bold mb-3">
          Índice de Documentação
        </h4>
        <nav class="space-y-1 text-sm font-medium">
          {docNav.map(item => (
            <a 
              href={item.slug} 
              class={`block px-3 py-2 rounded-md transition-colors ${activeDoc === item.id ? 'bg-[#C87D32]/10 text-[#C87D32] font-semibold border-l-2 border-[#C87D32]' : 'text-[#18181B] hover:text-[#C87D32] hover:bg-[#F5F5F4]'}`}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <div class="mt-8 pt-6 border-t border-stone-100 text-xs text-[#A1A1AA] space-y-2">
          <div class="font-semibold text-[#18181B]">Repositórios de Referência:</div>
          <ul class="space-y-1 font-mono text-[11px]">
            <li><a href="https://github.com/BRAN-Org/bran-web-database-template" target="_blank" rel="noopener noreferrer" class="text-[#C87D32] hover:underline">bran-web-database-template ↗</a></li>
            <li><a href="https://github.com/BRAN-Org/schemas" target="_blank" rel="noopener noreferrer" class="text-[#C87D32] hover:underline">schemas ↗</a></li>
            <li><a href="https://github.com/BRAN-Org/calendar_config" target="_blank" rel="noopener noreferrer" class="text-[#C87D32] hover:underline">calendar_config ↗</a></li>
          </ul>
        </div>
      </aside>

      <!-- Conteúdo da Página de Docs -->
      <article class="lg:col-span-9 bg-white p-8 sm:p-12 rounded-xl border border-slate-200 shadow-xs prose prose-slate max-w-none">
        <slot />
      </article>
    </div>
  </div>
</Layout>
